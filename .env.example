# Copie este arquivo para ".env" e ajuste os valores:  cp .env.example .env
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).

# Banco de dados (usado pelo Docker Compose)
POSTGRES_USER=checkmate_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=checkmate_db

# Autenticacao JWT
# Gere uma chave forte com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_aleatoria_longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: origens permitidas, separadas por virgula (ex.: http://localhost:5500,https://meusite.com)
CORS_ORIGINS=*
